# Address of the deployed sync server. Leave unset in development to use `npm run server`
# on this computer. Copy to .env and restart `npx expo start` after changing it.
EXPO_PUBLIC_SYNC_URL=wss://faisaldev.site/lawhati-sync/

# The company panel whose employees can be assigned cards (its /api/lawhati endpoints). This is
# the default; set it only to try the app against another copy of the panel.
# EXPO_PUBLIC_PANEL_URL=https://panel.kayanalnhda.sa
